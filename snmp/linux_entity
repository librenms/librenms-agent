# Compares two OIDs component by component, numerically, for use with sort
# and for finding the next OID. A OID that is a prefix of another sorts first.
#
# Args:
# - $oid_a_parts :: Array ref of the numeric components of the first OID,
#       for example [ 1, 3, 6, 1, 2, 1, 47 ].
# - $oid_b_parts :: Same for the second OID.
#
# Returns -1, 0, or 1, the same as <=>.
#
# Example:
#
#     # returns -1 as 9 sorts before 10, which a string compare gets wrong
#     my $order = oid_compare( [ 1, 3, 9 ], [ 1, 3, 10 ] );
sub oid_compare {
	my ( $oid_a_parts, $oid_b_parts ) = @_;

	my $shortest = @{$oid_a_parts} < @{$oid_b_parts} ? scalar( @{$oid_a_parts} ) : scalar( @{$oid_b_parts} );
	for ( my $part_index = 0; $part_index < $shortest; $part_index++ ) {
		my $order = $oid_a_parts->[$part_index] <=> $oid_b_parts->[$part_index];
		return $order if $order;
	}

	return @{$oid_a_parts} <=> @{$oid_b_parts};
} ## end sub oid_compare

# Reads a sysfs or similar small text file, with surrounding whitespace removed.
#
# Args:
# - $path :: Full path to the file, for example '/sys/class/dmi/id/board_name'.
#
# Returns the contents as a string, or undef if it does not exist or can not be
# read. sysfs files can exist and still fail to read, such as a hwmon input for
# a sensor that is not connected, which also gives undef.
#
# Example:
#
#     my $board_name = read_sysfs('/sys/class/dmi/id/board_name') // '';
sub read_sysfs {
	my ($path) = @_;

	my $contents = read_file( $path, err_mode => 'quiet' );
	return undef if !defined($contents);

	return $contents =~ s/^\s+|\s+$//gr;
}

# Blanks the filler text BIOS vendors put in unused SMBIOS and DMI fields,
# such as 'To Be Filled By O.E.M.', so it does not end up in the inventory.
#
# Args:
# - $value :: The string from DMI or SMBIOS, may be undef.
#
# Returns the value with surrounding whitespace removed, as SMBIOS strings are
# often padded, or '' if it is undef or filler.
#
# Example:
#
#     # returns ''
#     my $serial = clean_dmi('Not Specified');
sub clean_dmi {
	my ($value) = @_;

	return '' if !defined($value);
	$value =~ s/^\s+|\s+$//g;
	return '' if $value =~ /^(?:not specified|to be filled by o\.e\.m\.|default string|unknown|none|n\/a|0+|)$/i;

	return $value;
}

# Reads all the SMBIOS structures of one type from /sys/firmware/dmi/entries.
# Needs root as those files are only readable by it.
#
# Args:
# - $smbios_type :: The SMBIOS structure type number, such as 4 for processors
#       or 17 for memory devices.
#
# Returns a array ref of hash refs, one per structure, in the order the kernel
# lists them. formatted is the raw bytes of the formatted area, including the four
# byte header, so the offsets in the SMBIOS spec can be used on it directly.
# strings is the string table, where a string number N from the formatted area is
# at index N - 1. Returns a empty array ref if there are none or they can not be read.
#
#     [
#         {
#             formatted => "\x11\x28\x2a\x00...",
#             strings   => [ 'DIMM A', 'BANK 0', 'Samsung', '12345678', 'M471A1K43DB1-CWE' ],
#         },
#     ]
#
# Example:
#
#     foreach my $structure ( @{ read_smbios_structures(17) } ) {
#         my $locator_number = ord( substr( $structure->{formatted}, 0x10, 1 ) );
#         print $structure->{strings}[ $locator_number - 1 ] . "\n" if $locator_number;
#     }
sub read_smbios_structures {
	my ($smbios_type) = @_;

	my @structures;
	foreach my $entry_dir ( sort { $a cmp $b } glob( '/sys/firmware/dmi/entries/' . $smbios_type . '-*' ) ) {
		my $raw = read_file( $entry_dir . '/raw', binmode => ':raw', err_mode => 'quiet' );
		next if !defined($raw) || length($raw) < 4;

		# the second byte of the header is the length of the formatted area, with
		# the NUL terminated strings after it and a extra NUL ending the table
		my $formatted_length = ord( substr( $raw, 1, 1 ) );
		push(
			@structures,
			{
				formatted => substr( $raw, 0, $formatted_length ),
				strings   => [ split( /\0/, substr( $raw, $formatted_length ) ) ],
			}
		);
	} ## end foreach my $entry_dir ( sort { $a cmp $b } glob...)

	return \@structures;
} ## end sub read_smbios_structures

# Parses the text output of 'ethtool -m $interface'. Handles the SFF-8472
# layout used for SFP and the per channel layout used for QSFP, SFF-8636
# and CMIS, as printed by ethtool.
#
# Args:
# - $ethtool_output :: The full output of 'ethtool -m', as a string. Each line is
#       a label, padding, a colon, and the value...
#
#       Identifier                                : 0x03 (SFP)
#       Vendor name                               : FINISAR CORP.
#       Laser bias current                        : 6.162 mA
#       Laser output power                        : 0.6233 mW / -2.05 dBm
#       Laser bias current high alarm             : Off
#
# Returns a hash ref. The info keys are strings and are empty if ethtool did not
# print them. readings is a array ref of hash refs, one per reading found, each with
# the kind of reading, the lane, 0 if it is not per channel, and the value. Kind is
# one of temperature in C, voltage in V, bias in mA, tx_power in dBm, or rx_power
# in dBm. -inf dBm becomes -40. alarms and warnings are how many of the alarm and
# warning flags are on.
#
#     {
#         identifier       => 'SFP',
#         transceiver_type => '10G Ethernet: 10G Base-SR',
#         vendor_name      => 'FINISAR CORP.',
#         vendor_pn        => 'FTLX8571D3BCL',
#         vendor_rev       => 'A',
#         vendor_sn        => 'AAA0B1C',
#         readings         => [
#             { kind => 'bias',     lane => 0, value => 6.162 },
#             { kind => 'tx_power', lane => 0, value => -2.05 },
#         ],
#         alarms   => 0,
#         warnings => 1,
#     }
#
# Example:
#
#     my $module_info = parse_ethtool_module( $ethtool_output );
#     print $module_info->{vendor_pn} . "\n";
sub parse_ethtool_module {
	my ($ethtool_output) = @_;

	my %labels_to_keys = (
		'identifier'       => 'identifier',
		'transceiver type' => 'transceiver_type',
		'vendor name'      => 'vendor_name',
		'vendor pn'        => 'vendor_pn',
		'vendor rev'       => 'vendor_rev',
		'vendor sn'        => 'vendor_sn',
	);

	# The labels differ between ethtool versions and between the SFP and QSFP layouts.
	# Anchored at both ends so the threshold and alarm lines, which start the same, do not match.
	my @reading_patterns = (
		[ 'temperature', qr/^module temperature$/,                                         qr/(-?[\d.]+)\s*degrees C/ ],
		[ 'voltage',     qr/^module voltage$/,                                             qr/(-?[\d.]+)\s*V/ ],
		[ 'bias',        qr/^laser (?:tx )?bias current\s*(?:\(channel (?<lane>\d+)\))?$/, qr/(-?[\d.]+)\s*mA/ ],
		[
			'tx_power', qr/^(?:laser output power|transmit avg optical power)\s*(?:\(channel (?<lane>\d+)\))?$/,
			qr/(-?(?:[\d.]+|inf))\s*dBm/
		],
		[
			'rx_power',
			qr/^(?:receiver signal average optical power|rcvr signal avg optical power)\s*(?:\(channel (?<lane>\d+)\))?$/,
			qr/(-?(?:[\d.]+|inf))\s*dBm/
		],
	);

	my %module_info = (
		identifier       => '',
		transceiver_type => '',
		vendor_name      => '',
		vendor_pn        => '',
		vendor_rev       => '',
		vendor_sn        => '',
		readings         => [],
		alarms           => 0,
		warnings         => 0,
	);

	foreach my $line ( split( /\n/, $ethtool_output ) ) {
		# the label never has a colon, but the value may, such as '10G Ethernet: 10G Base-SR'
		my ( $label, $value ) = $line =~ /^\s*([^:]+?)\s*:\s*(.*?)\s*$/;
		next if !defined($label);
		$label = lc($label);

		my $info_key = $labels_to_keys{$label};
		if ( defined($info_key) ) {
			# first one wins, as some, such as transceiver type, can be printed more than once
			if ( $module_info{$info_key} eq '' ) {
				$module_info{$info_key} = $value;
			}
			next;
		}

		# Flags are 'On' or 'Off', or a bracketed list of them for multi lane ones. The
		# thresholds share the label start, but their values are numbers so never match.
		if ( $value =~ /\bon\b/i ) {
			if ( $label =~ /\balarm\b/ ) {
				$module_info{alarms}++;
			} elsif ( $label =~ /\bwarning\b/ ) {
				$module_info{warnings}++;
			}
		}

		foreach my $reading_pattern (@reading_patterns) {
			my ( $kind, $label_regexp, $value_regexp ) = @{$reading_pattern};
			next if $label !~ $label_regexp;
			# named so a pattern without a channel group gives no lane instead of the 1 a plain list match returns
			my $lane = $+{lane};
			my ($reading) = $value =~ $value_regexp or last;
			if ( $reading =~ /inf$/ ) {
				$reading = -40;
			}
			push( @{ $module_info{readings} }, { kind => $kind, lane => $lane // 0, value => $reading + 0 } );
			last;
		} ## end foreach my $reading_pattern (@reading_patterns)
	} ## end foreach my $line ( split( /\n/, $ethtool_output...))

	# '0x03 (SFP)' to 'SFP'
	if ( $module_info{identifier} =~ /\((.+)\)/ ) {
		$module_info{identifier} = $1;
	}

	return \%module_info;
} ## end sub parse_ethtool_module

# Reads the cache and returns the OIDs in it that are under the base OID, in order.
#
# Args:
# - $cache_file :: Full path to the cache file written by -u.
# - $base_oid :: Only OIDs under this are returned, for example '.1.3.6.1.2.1.47'.
#       Undef returns all of them.
#
# Returns a array ref of hash refs, sorted by OID, each with the OID as a string,
# its numeric parts as a array ref, its pass_persist type, and its value. Returns
# a empty array ref if the cache does not exist or can not be parsed, so a missing
# cache just means nothing is answered.
#
#     [
#         {
#             oid   => '.1.3.6.1.2.1.47.1.1.1.1.2.1',
#             parts => [ 1, 3, 6, 1, 2, 1, 47, 1, 1, 1, 1, 2, 1 ],
#             type  => 'string',
#             value => 'Chassis',
#         },
#     ]
#
# Example:
#
#     my $entries = load_cache( '/var/cache/linux_entity/entity.json', '.1.3.6.1.2.1.99' );
sub load_cache {
	my ( $cache_file, $base_oid ) = @_;

	my $cache = eval { decode_json( read_file($cache_file) ) };
	return [] if ref($cache) ne 'HASH' || ref( $cache->{oids} ) ne 'ARRAY';

	my $base_prefix = defined($base_oid) ? $base_oid . '.' : '';

	my @entries;
	foreach my $cached_oid ( @{ $cache->{oids} } ) {
		my ( $oid, $type, $value ) = @{$cached_oid};
		next if index( $oid, $base_prefix ) != 0;
		push(
			@entries,
			{
				oid   => $oid,
				parts => [ grep { $_ ne '' } split( /\./, $oid ) ],
				type  => $type,
				value => $value,
			}
		);
	} ## end foreach my $cached_oid ( @{ $cache->{oids} } )

	return [ sort { oid_compare( $a->{parts}, $b->{parts} ) } @entries ];
} ## end sub load_cache

#gets the options
my %opts;
# i and I are array refs as they may be given more than once
Getopt::Long::Configure( 'bundling', 'no_ignore_case' );
GetOptions( \%opts, 'u', 'p=s', 'w', 'd=s', 'i=s@', 'I=s@', 'hwmon', 'hwmon-kinds=s',
	'rapl', 'power', 'inventory', 'state', 'help', 'version' )
	or exit 255;

if ( defined( $opts{'hwmon-kinds'} ) ) {
	$opts{hwmon} = 1;
}

if ( $opts{version} ) {
	main::VERSION_MESSAGE();
	exit 0;
}

if ( $opts{help} ) {
	main::VERSION_MESSAGE();
	main::HELP_MESSAGE();
}

my $modes_given = grep { defined( $opts{$_} ) } ( 'u', 'p', 'w' );
if ( $modes_given != 1 ) {
	die('One of -u, -p, or -w is required');
}

if ( !$opts{u} && grep { $opts{$_} } ( 'hwmon', 'rapl', 'power', 'inventory', 'state' ) ) {
	die('--hwmon, --hwmon-kinds, --rapl, --power, --inventory, and --state are only used with -u');
}

my $cache_dir  = defined( $opts{d} ) ? $opts{d} : '/var/cache/linux_entity';
my $cache_file = $cache_dir . '/entity.json';
my $state_file = $cache_dir . '/state.json';

if ( $opts{u} ) {
	# compiled up front so a bad regexp dies before anything is done
	my @include_regexps = map { qr/$_/ } @{ $opts{i} || [] };
	my @ignore_regexps  = map { qr/$_/ } @{ $opts{I} || [] };

	# cron often lacks sbin in the path
	my ($ethtool) = grep { -x $_ } ( '/usr/sbin/ethtool', '/sbin/ethtool', '/usr/bin/ethtool', '/bin/ethtool' );
	if ( !defined($ethtool) ) {
		die('ethtool not found');
	}

	if ( !-d $cache_dir ) {
		mkdir( $cache_dir, 0755 ) or die( 'Failed to create "' . $cache_dir . '"... ' . $! );
	}

	# What has to be kept between runs. index_map is stable key to entPhysicalIndex for
	# everything not using the ifindex based ones, with next_index the last one handed out.
	# rapl is the previous energy reading and time for each zone, keyed by zone name.
	my $state = eval { decode_json( read_file($state_file) ) };
	if ( ref($state) ne 'HASH' ) {
		$state = {};
	}
	$state->{index_map}  //= {};
	$state->{next_index} //= 999999999;
	$state->{rapl}       //= {};

	my $index_for = sub {
		my ($stable_key) = @_;
		$state->{index_map}{$stable_key} //= ++$state->{next_index};
		return $state->{index_map}{$stable_key};
	};

	# entPhysicalClass values
	my %entity_classes = (
		other         => 1,
		chassis       => 3,
		power_supply  => 6,
		sensor        => 8,
		module        => 9,
		port          => 10,
		cpu           => 12,
		battery       => 14,
		storage_drive => 15,
	);

	# Each is [ OID, pass_persist type, value ]. The entPhysicalTable columns
	# are, in order, Descr, VendorType, ContainedIn, Class, ParentRelPos, Name,
	# HardwareRev, FirmwareRev, SoftwareRev, SerialNum, MfgName, ModelName,
	# Alias, AssetID, and IsFRU, which are 2 to 16.
	my @oids;
	my $add_entity = sub {
		my (%entity) = @_;
		my @columns = (
			[ 'string',   $entity{descr} ],
			[ 'objectid', '.0.0' ],
			[ 'integer',  $entity{contained_in} ],
			[ 'integer',  $entity{class} ],
			[ 'integer',  $entity{parent_rel_pos} ],
			[ 'string',   $entity{name} ],
			[ 'string',   $entity{hardware_rev} // '' ],
			[ 'string',   $entity{firmware_rev} // '' ],
			[ 'string',   '' ],
			[ 'string',   $entity{serial}     // '' ],
			[ 'string',   $entity{mfg_name}   // '' ],
			[ 'string',   $entity{model_name} // '' ],
			[ 'string',   '' ],
			[ 'string',   '' ],
			[ 'integer',  $entity{is_fru} ? 1 : 2 ],
		);
		for ( my $column_index = 0; $column_index < @columns; $column_index++ ) {
			my ( $type, $value ) = @{ $columns[$column_index] };
			# a newline would break the pass_persist protocol
			$value =~ s/[\r\n]+/ /g;
			push( @oids,
				[ '.1.3.6.1.2.1.47.1.1.1.1.' . ( $column_index + 2 ) . '.' . $entity{index}, $type, $value ] );
		}
	}; ## end $add_entity = sub

	# Adds a sensor entity and its entPhySensorTable row. Takes index, name,
	# contained_in, parent_rel_pos, type, scale, precision, value, and units.
	#
	# type is the entPhySensorType, 1 other, 4 voltsDC, 5 amperes, 6 watts, 8 celsius,
	# 9 percentRH, or 10 rpm. scale is the entPhySensorScale, 7 micro, 8 milli, or 9 units.
	# value is the integer to send, the reading being value / 10 ** precision at that scale.
	my $add_sensor = sub {
		my (%sensor) = @_;

		# entPhySensorValue is a Integer32
		return if abs( $sensor{value} ) > 2147483647;

		$add_entity->(
			index          => $sensor{index},
			descr          => $sensor{name},
			name           => $sensor{name},
			contained_in   => $sensor{contained_in},
			class          => $entity_classes{sensor},
			parent_rel_pos => $sensor{parent_rel_pos},
		);

		# Type, Scale, Precision, Value, OperStatus of ok, and UnitsDisplay
		my @sensor_columns = (
			[ 'integer', $sensor{type} ],
			[ 'integer', $sensor{scale} ],
			[ 'integer', $sensor{precision} ],
			[ 'integer', $sensor{value} ],
			[ 'integer', 1 ],
			[ 'string',  $sensor{units} ],
		);
		for ( my $column_index = 0; $column_index < @sensor_columns; $column_index++ ) {
			push(
				@oids,
				[
					'.1.3.6.1.2.1.99.1.1.1.' . ( $column_index + 1 ) . '.' . $sensor{index},
					@{ $sensor_columns[$column_index] }
				]
			);
		}
	}; ## end $add_sensor = sub

	# Adds a entStateTable row if --state was given. Takes index, admin, oper, and
	# the alarms as a hash ref of critical, major, and warning, true for each set.
	#
	# admin is entStateAdmin, 1 unknown, 2 locked, or 4 unlocked. oper is entStateOper,
	# 1 unknown, 2 disabled, or 3 enabled. Usage and standby are always 1, unknown.
	my $add_state = sub {
		my (%entity_state) = @_;
		return if !$opts{state};

		# entStateAlarm is BITS, numbered from the high bit of the first octet, with
		# critical as 2, major as 3, and warning as 5. Sent as hex for the octet type.
		my $alarm_bits = 0;
		$alarm_bits |= 0x20 if $entity_state{alarms}{critical};
		$alarm_bits |= 0x10 if $entity_state{alarms}{major};
		$alarm_bits |= 0x04 if $entity_state{alarms}{warning};

		my @state_columns = (
			[ 2, 'integer', $entity_state{admin} ],
			[ 3, 'integer', $entity_state{oper} ],
			[ 4, 'integer', 1 ],
			[ 5, 'octet',   sprintf( '%02X', $alarm_bits ) ],
			[ 6, 'integer', 1 ],
		);
		foreach my $state_column (@state_columns) {
			my ( $column, $type, $value ) = @{$state_column};
			push( @oids, [ '.1.3.6.1.2.1.131.1.1.1.' . $column . '.' . $entity_state{index}, $type, $value ] );
		}
	}; ## end $add_state = sub

	#
	# chassis
	#

	my %dmi;
	foreach my $dmi_item (
		'sys_vendor',   'product_name', 'product_serial', 'bios_version',
		'board_vendor', 'board_name',   'board_version',  'board_serial'
		)
	{
		$dmi{$dmi_item} = clean_dmi( read_sysfs( '/sys/class/dmi/id/' . $dmi_item ) );
	}
	$add_entity->(
		index          => 1,
		descr          => 'Chassis',
		name           => 'Chassis',
		contained_in   => 0,
		class          => $entity_classes{chassis},
		parent_rel_pos => -1,
		firmware_rev   => $dmi{bios_version},
		serial         => $dmi{product_serial},
		mfg_name       => $dmi{sys_vendor},
		model_name     => $dmi{product_name},
	);

	#
	# transceivers
	#

	# offset is added to the port index, plus the lane for those that can have more than one
	my %transceiver_sensor_kinds = (
		temperature =>
			{ offset => 10, type => 8, scale => 9, precision => 2, units => 'C', name => 'Temperature Sensor' },
		voltage => { offset => 11, type => 4, scale => 9, precision => 3, units => 'V', name => 'Voltage Sensor' },
		bias    =>
			{ offset => 100, type => 5, scale => 8, precision => 3, units => 'mA', name => 'Bias Current Sensor' },
		tx_power =>
			{ offset => 200, type => 1, scale => 9, precision => 2, units => 'dBm', name => 'Tx Power Sensor' },
		rx_power =>
			{ offset => 300, type => 1, scale => 9, precision => 2, units => 'dBm', name => 'Rx Power Sensor' },
	);

	opendir( my $net_dh, '/sys/class/net' ) or die( 'Failed to open /sys/class/net... ' . $! );
	my @interfaces = sort { $a cmp $b } grep { -e '/sys/class/net/' . $_ . '/device' } readdir($net_dh);
	closedir($net_dh);

	foreach my $interface (@interfaces) {
		next if @include_regexps && !grep { $interface =~ $_ } @include_regexps;
		next if grep                      { $interface =~ $_ } @ignore_regexps;

		my $ifindex = read_sysfs( '/sys/class/net/' . $interface . '/ifindex' );
		# keeps the transceiver indexes under the 1000000000 the others start at
		next if !defined($ifindex) || $ifindex > 999999;

		# ethtool complains on stderr for every NIC that lacks a module, which is
		# just noise in cron mail, so it is pointed at /dev/null for the run
		open( my $saved_stderr, '>&', \*STDERR ) or die( 'Failed to dup stderr... ' . $! );
		open( STDERR,           '>',  '/dev/null' );
		my $ethtool_ok     = open( my $ethtool_fh, '-|', $ethtool, '-m', $interface );
		my $ethtool_output = $ethtool_ok ? join( '', <$ethtool_fh> ) : '';
		# close returns false when ethtool exits non-zero, which is how a missing module shows
		$ethtool_ok = $ethtool_ok && close($ethtool_fh);
		open( STDERR, '>&', $saved_stderr );
		next if !$ethtool_ok;

		my $module_info = parse_ethtool_module($ethtool_output);
		# raw hex output or something else not understood
		next if $module_info->{identifier} eq '';

		my $port_index   = $ifindex * 1000;
		my $module_index = $port_index + 1;

		$add_entity->(
			index          => $port_index,
			descr          => $interface,
			name           => $interface,
			contained_in   => 1,
			class          => $entity_classes{port},
			parent_rel_pos => $ifindex,
		);
		# entAliasMappingIdentifier, with 0 as the logical index
		push( @oids,
			[ '.1.3.6.1.2.1.47.1.3.2.1.2.' . $port_index . '.0', 'objectid', '.1.3.6.1.2.1.2.2.1.1.' . $ifindex ] );

		$add_entity->(
			index        => $module_index,
			descr        => join( ' ', grep { $_ ne '' } $module_info->{identifier}, $module_info->{transceiver_type} ),
			name         => $interface . ' Transceiver',
			contained_in => $port_index,
			class        => $entity_classes{module},
			parent_rel_pos => 1,
			hardware_rev   => $module_info->{vendor_rev},
			serial         => $module_info->{vendor_sn},
			mfg_name       => $module_info->{vendor_name},
			model_name     => $module_info->{vendor_pn},
			is_fru         => 1,
		);

		# IFF_UP is the lowest bit of the interface flags
		my $interface_flags = read_sysfs( '/sys/class/net/' . $interface . '/flags' ) // '0';
		$add_state->(
			index  => $module_index,
			admin  => hex($interface_flags) & 1 ? 4 : 2,
			oper   => 3,
			alarms => { critical => $module_info->{alarms}, warning => $module_info->{warnings} },
		);

		my $sensor_position = 1;
		foreach my $reading ( @{ $module_info->{readings} } ) {
			my $sensor_kind = $transceiver_sensor_kinds{ $reading->{kind} };
			my $sensor_name
				= $reading->{lane}
				? $interface . ' Lane ' . $reading->{lane} . ' ' . $sensor_kind->{name}
				: $interface . ' ' . $sensor_kind->{name};
			$add_sensor->(
				index          => $port_index + $sensor_kind->{offset} + $reading->{lane},
				name           => $sensor_name,
				contained_in   => $module_index,
				parent_rel_pos => $sensor_position++,
				type           => $sensor_kind->{type},
				scale          => $sensor_kind->{scale},
				precision      => $sensor_kind->{precision},
				value          => sprintf( '%.0f', $reading->{value} * 10**$sensor_kind->{precision} ),
				units          => $sensor_kind->{units},
			);
		} ## end foreach my $reading ( @{ $module_info->{readings...}})
	} ## end foreach my $interface (@interfaces)

	#
	# hwmon
	#

	if ( $opts{hwmon} ) {
		# The hwmon input files and how their raw values map to ENTITY-SENSOR-MIB. Power is
		# in microwatts, which is sent at milli scale so a big PSU does not overflow.
		my %hwmon_kinds = (
			temp     => { type => 8,  scale => 8, divide => 1,    units => 'C' },
			in       => { type => 4,  scale => 8, divide => 1,    units => 'V' },
			curr     => { type => 5,  scale => 8, divide => 1,    units => 'A' },
			power    => { type => 6,  scale => 8, divide => 1000, units => 'W' },
			fan      => { type => 10, scale => 9, divide => 1,    units => 'RPM' },
			humidity => { type => 9,  scale => 8, divide => 1,    units => '%RH' },
		);

		# dropping the unwanted kinds here is all it takes, as files of kinds not in it are skipped
		if ( defined( $opts{'hwmon-kinds'} ) ) {
			my %wanted_kinds  = map  { $_ => 1 } split( /\s*,\s*/, $opts{'hwmon-kinds'} );
			my @unknown_kinds = grep { !$hwmon_kinds{$_} } sort( keys(%wanted_kinds) );
			if (@unknown_kinds) {
				die(      '--hwmon-kinds has unknown kinds "'
						. join( ',', @unknown_kinds )
						. '", valid ones are temp, in, curr, power, fan, and humidity' );
			}
			foreach my $kind ( keys(%hwmon_kinds) ) {
				delete( $hwmon_kinds{$kind} ) if !$wanted_kinds{$kind};
			}
		} ## end if ( defined( $opts{'hwmon-kinds'} ) )

		my @hwmon_dirs = sort { $a cmp $b } glob('/sys/class/hwmon/hwmon*');

		# coretemp, nvme, and the like show up once per socket or drive, so those get the
		# device name added to tell them apart
		my %chip_name_counts;
		foreach my $hwmon_dir (@hwmon_dirs) {
			$chip_name_counts{ read_sysfs( $hwmon_dir . '/name' ) // '' }++;
		}

		foreach my $hwmon_dir (@hwmon_dirs) {
			my $chip_name   = read_sysfs( $hwmon_dir . '/name' ) // next;
			my $device_path = -e $hwmon_dir . '/device' ? realpath( $hwmon_dir . '/device' ) : '';
			# reported by --power with more detail
			next if $opts{power} && $device_path =~ m{/power_supply/};

			my $chip_display_name = $chip_name;
			if ( $chip_name_counts{$chip_name} > 1 && $device_path ne '' ) {
				$chip_display_name = $chip_name . ' ' . ( $device_path =~ s{.*/}{}r );
			}

			# input is preferred, with average used if that is all there is, which is common for power
			my %sensor_files;
			opendir( my $hwmon_dh, $hwmon_dir ) or next;
			foreach my $file ( readdir($hwmon_dh) ) {
				my ( $kind, $number, $reading_type ) = $file =~ /^([a-z]+)(\d+)_(input|average)$/ or next;
				next if !$hwmon_kinds{$kind};
				if ( $reading_type eq 'input' || !defined( $sensor_files{$kind}{$number} ) ) {
					$sensor_files{$kind}{$number} = $file;
				}
			}
			closedir($hwmon_dh);
			# Read first, so a device whose inputs all fail to read, such as a powered down
			# GPU, is skipped instead of showing up with no sensors.
			my @readings;
			foreach my $kind ( sort { $a cmp $b } keys(%sensor_files) ) {
				foreach my $number ( sort { $a <=> $b } keys( %{ $sensor_files{$kind} } ) ) {
					# some drivers leave disabled or unconnected inputs readable, but with a enable of 0
					next if ( read_sysfs( $hwmon_dir . '/' . $kind . $number . '_enable' ) // 1 ) eq '0';
					my $raw_value = read_sysfs( $hwmon_dir . '/' . $sensor_files{$kind}{$number} );
					next if !defined($raw_value) || $raw_value !~ /^-?\d+$/;
					push( @readings, { kind => $kind, number => $number, raw_value => $raw_value } );
				}
			}
			next if !@readings;

			my $chip_key   = 'hwmon:' . $device_path . ':' . $chip_name;
			my $chip_index = $index_for->($chip_key);
			$add_entity->(
				index          => $chip_index,
				descr          => $chip_display_name,
				name           => $chip_display_name,
				contained_in   => 1,
				class          => $entity_classes{other},
				parent_rel_pos => -1,
			);

			my $sensor_position = 1;
			foreach my $reading (@readings) {
				my $kind   = $reading->{kind};
				my $number = $reading->{number};
				my $label  = read_sysfs( $hwmon_dir . '/' . $kind . $number . '_label' ) // $kind . $number;
				$add_sensor->(
					index          => $index_for->( $chip_key . ':' . $kind . $number ),
					name           => $chip_display_name . ' ' . $label,
					contained_in   => $chip_index,
					parent_rel_pos => $sensor_position++,
					type           => $hwmon_kinds{$kind}{type},
					scale          => $hwmon_kinds{$kind}{scale},
					precision      => 0,
					value          => sprintf( '%.0f', $reading->{raw_value} / $hwmon_kinds{$kind}{divide} ),
					units          => $hwmon_kinds{$kind}{units},
				);
			} ## end foreach my $reading (@readings)
		} ## end foreach my $hwmon_dir (@hwmon_dirs)
	} ## end if ( $opts{hwmon} )

	#
	# RAPL
	#

	if ( $opts{rapl} ) {
		# intel-rapl:0 is package 0, with intel-rapl:0:0 and so on being the core, uncore,
		# and DRAM zones in it. AMD uses the same names. intel-rapl-mmio duplicates the
		# package zones on some Intel systems, so it is not used.
		my $sensor_position = 1;
		foreach my $zone_dir ( sort { $a cmp $b } glob('/sys/class/powercap/intel-rapl:*') ) {
			my $zone = $zone_dir =~ s{.*/}{}r;

			my $energy_uj = read_sysfs( $zone_dir . '/energy_uj' );
			next if !defined($energy_uj) || $energy_uj !~ /^\d+$/;
			my $now = time;

			my $zone_name = read_sysfs( $zone_dir . '/name' ) // $zone;
			# names a subzone after its package, such as 'package-0 core'
			if ( $zone =~ /^(intel-rapl:\d+):\d+$/ ) {
				$zone_name = ( read_sysfs( '/sys/class/powercap/' . $1 . '/name' ) // $1 ) . ' ' . $zone_name;
			}

			my $previous = $state->{rapl}{$zone};
			$state->{rapl}{$zone} = { energy_uj => $energy_uj, time => $now };
			# also skips it if the previous run was long enough ago for the counter to wrap more than once
			next if ref($previous) ne 'HASH' || $now <= $previous->{time} || $now - $previous->{time} > 3600;

			my $used_uj = $energy_uj - $previous->{energy_uj};
			if ( $used_uj < 0 ) {
				my $max_energy_uj = read_sysfs( $zone_dir . '/max_energy_range_uj' ) // next;
				$used_uj += $max_energy_uj;
			}

			# microjoules per second is microwatts, sent as milliwatts
			$add_sensor->(
				index          => $index_for->( 'rapl:' . $zone ),
				name           => 'RAPL ' . $zone_name,
				contained_in   => 1,
				parent_rel_pos => $sensor_position++,
				type           => 6,
				scale          => 8,
				precision      => 0,
				value          => sprintf( '%.0f', $used_uj / ( $now - $previous->{time} ) / 1000 ),
				units          => 'W',
			);
		} ## end foreach my $zone_dir ( sort { $a cmp $b } glob(...))
	} ## end if ( $opts{rapl} )

	#
	# power supplies
	#

	if ( $opts{power} ) {
		# The power_supply files and how their raw values map to ENTITY-SENSOR-MIB.
		# Voltage, current, and power are in micro units, and temp is in tenths of a degree C.
		my @power_supply_readings = (
			[ 'voltage_now', 'Voltage',     { type => 4, scale => 7, precision => 0, units => 'V' } ],
			[ 'current_now', 'Current',     { type => 5, scale => 7, precision => 0, units => 'A' } ],
			[ 'power_now',   'Power',       { type => 6, scale => 7, precision => 0, units => 'W' } ],
			[ 'temp',        'Temperature', { type => 8, scale => 9, precision => 1, units => 'C' } ],
		);

		my $supply_position = 1;
		foreach my $supply_dir ( sort { $a cmp $b } glob('/sys/class/power_supply/*') ) {
			my $supply_name = $supply_dir =~ s{.*/}{}r;
			my $supply_type = read_sysfs( $supply_dir . '/type' ) // 'Unknown';
			my $mfg_name    = clean_dmi( read_sysfs( $supply_dir . '/manufacturer' ) );
			my $model_name  = clean_dmi( read_sysfs( $supply_dir . '/model_name' ) );

			my $supply_index = $index_for->( 'power_supply:' . $supply_name );
			$add_entity->(
				index          => $supply_index,
				descr          => join( ' ', grep { $_ ne '' } $mfg_name, $model_name, $supply_type ),
				name           => $supply_name,
				contained_in   => 1,
				class          => $supply_type eq 'Battery' ? $entity_classes{battery} : $entity_classes{power_supply},
				parent_rel_pos => $supply_position++,
				serial         => clean_dmi( read_sysfs( $supply_dir . '/serial_number' ) ),
				mfg_name       => $mfg_name,
				model_name     => $model_name,
			);

			my $online         = read_sysfs( $supply_dir . '/online' );
			my $capacity_level = read_sysfs( $supply_dir . '/capacity_level' ) // '';
			my $health         = read_sysfs( $supply_dir . '/health' )         // 'Good';
			$add_state->(
				index  => $supply_index,
				admin  => 1,
				oper   => !defined($online) ? 1 : $online ? 3 : 2,
				alarms => {
					critical => $capacity_level eq 'Critical',
					major    => $health !~ /^(?:good|unknown)$/i,
					warning  => $capacity_level eq 'Low',
				},
			);

			my $sensor_position = 1;
			foreach my $power_supply_reading (@power_supply_readings) {
				my ( $file, $label, $sensor_kind ) = @{$power_supply_reading};
				my $raw_value = read_sysfs( $supply_dir . '/' . $file );
				next if !defined($raw_value) || $raw_value !~ /^-?\d+$/;
				$add_sensor->(
					index          => $index_for->( 'power_supply:' . $supply_name . ':' . $file ),
					name           => $supply_name . ' ' . $label,
					contained_in   => $supply_index,
					parent_rel_pos => $sensor_position++,
					value          => $raw_value,
					%{$sensor_kind},
				);
			} ## end foreach my $power_supply_reading (@power_supply_readings)
		} ## end foreach my $supply_dir ( sort { $a cmp $b } glob...)
	} ## end if ( $opts{power} )

	#
	# inventory
	#

	if ( $opts{inventory} ) {
		my $board_index = $index_for->('board');
		$add_entity->(
			index          => $board_index,
			descr          => join( ' ', grep { $_ ne '' } $dmi{board_vendor}, $dmi{board_name} ) || 'Motherboard',
			name           => 'Motherboard',
			contained_in   => 1,
			class          => $entity_classes{module},
			parent_rel_pos => -1,
			hardware_rev   => $dmi{board_version},
			serial         => $dmi{board_serial},
			mfg_name       => $dmi{board_vendor},
			model_name     => $dmi{board_name},
		);

		# Returns the string a SMBIOS string number at the given offset of the
		# formatted area points to, or '' if the structure is too short for it,
		# it is 0 for none, or it is filler text.
		my $smbios_string = sub {
			my ( $structure, $offset ) = @_;
			return '' if length( $structure->{formatted} ) <= $offset;
			my $string_number = ord( substr( $structure->{formatted}, $offset, 1 ) );
			return '' if !$string_number;
			return clean_dmi( $structure->{strings}[ $string_number - 1 ] );
		};

		# SMBIOS type 4, processors. Socket designation is at 0x04, manufacturer at 0x07,
		# version, which is the model, at 0x10, status at 0x18, serial at 0x20, and part
		# number at 0x22. Bit 6 of status is set if the socket is populated.
		my $cpu_position = 1;
		foreach my $cpu_structure ( @{ read_smbios_structures(4) } ) {
			next if length( $cpu_structure->{formatted} ) <= 0x18;
			next if !( ord( substr( $cpu_structure->{formatted}, 0x18, 1 ) ) & 0x40 );

			my $socket = $smbios_string->( $cpu_structure, 0x04 ) || 'CPU ' . $cpu_position;
			my $model  = $smbios_string->( $cpu_structure, 0x10 );
			$add_entity->(
				index          => $index_for->( 'cpu:' . $socket ),
				descr          => $model || $socket,
				name           => $socket,
				contained_in   => $board_index,
				class          => $entity_classes{cpu},
				parent_rel_pos => $cpu_position++,
				serial         => $smbios_string->( $cpu_structure, 0x20 ),
				mfg_name       => $smbios_string->( $cpu_structure, 0x07 ),
				model_name     => $smbios_string->( $cpu_structure, 0x22 ) || $model,
				is_fru         => 1,
			);
		} ## end foreach my $cpu_structure ( @{ read_smbios_structures...})

		# SMBIOS type 17, memory devices. Size is a word at 0x0C, device locator at 0x10,
		# bank locator at 0x11, memory type at 0x12, speed a word at 0x15, manufacturer at
		# 0x17, serial at 0x18, part number at 0x1A, and extended size a dword at 0x1C.
		my %memory_types = (
			0x12 => 'DDR',
			0x13 => 'DDR2',
			0x18 => 'DDR3',
			0x1A => 'DDR4',
			0x1B => 'LPDDR',
			0x1C => 'LPDDR2',
			0x1D => 'LPDDR3',
			0x1E => 'LPDDR4',
			0x22 => 'DDR5',
			0x23 => 'LPDDR5',
		);
		my $dimm_position = 1;
		foreach my $dimm_structure ( @{ read_smbios_structures(17) } ) {
			my $formatted = $dimm_structure->{formatted};
			next if length($formatted) <= 0x12;

			# 0 is a empty slot and 0xFFFF unknown. 0x7FFF means the size is in the extended
			# size, in MB. Otherwise it is in MB, or KB if the high bit is set.
			my $size_word = unpack( 'v', substr( $formatted, 0x0C, 2 ) );
			next if $size_word == 0 || $size_word == 0xFFFF;
			my $size_mb;
			if ( $size_word == 0x7FFF ) {
				next if length($formatted) < 0x20;
				$size_mb = unpack( 'V', substr( $formatted, 0x1C, 4 ) ) & 0x7FFFFFFF;
			} elsif ( $size_word & 0x8000 ) {
				$size_mb = ( $size_word & 0x7FFF ) / 1024;
			} else {
				$size_mb = $size_word;
			}

			my $speed = length($formatted) > 0x16 ? unpack( 'v', substr( $formatted, 0x15, 2 ) ) : 0;
			my $descr = join( ' ',
				$size_mb >= 1024 ? ( $size_mb / 1024 ) . ' GB' : $size_mb . ' MB',
				grep { $_ ne '' } $memory_types{ ord( substr( $formatted, 0x12, 1 ) ) } // '',
				$speed && $speed != 0xFFFF ? $speed . ' MT/s' : '' );

			my $locator = join( ' ',
				grep { $_ ne '' } $smbios_string->( $dimm_structure, 0x11 ),
				$smbios_string->( $dimm_structure, 0x10 ) )
				|| 'DIMM ' . $dimm_position;
			$add_entity->(
				index          => $index_for->( 'dimm:' . $locator ),
				descr          => $descr,
				name           => $locator,
				contained_in   => $board_index,
				class          => $entity_classes{module},
				parent_rel_pos => $dimm_position++,
				serial         => $smbios_string->( $dimm_structure, 0x18 ),
				mfg_name       => $smbios_string->( $dimm_structure, 0x17 ),
				model_name     => $smbios_string->( $dimm_structure, 0x1A ),
				is_fru         => 1,
			);
		} ## end foreach my $dimm_structure ( @{ read_smbios_structures...})

		# Disks are keyed by their device path, which is the slot or port they are in, so a
		# swapped disk keeps the index with the serial changing. NVMe is done per controller
		# via /sys/class/nvme, as a controller can have more than one namespace under /sys/block.
		my $disk_position = 1;
		foreach my $nvme_dir ( sort { $a cmp $b } glob('/sys/class/nvme/nvme*') ) {
			my $model = read_sysfs( $nvme_dir . '/model' ) // next;
			next if !-e $nvme_dir . '/device';
			my $controller = $nvme_dir =~ s{.*/}{}r;
			$add_entity->(
				index          => $index_for->( 'disk:' . realpath( $nvme_dir . '/device' ) ),
				descr          => $model,
				name           => $controller,
				contained_in   => 1,
				class          => $entity_classes{storage_drive},
				parent_rel_pos => $disk_position++,
				firmware_rev   => read_sysfs( $nvme_dir . '/firmware_rev' ) // '',
				serial         => read_sysfs( $nvme_dir . '/serial' )       // '',
				model_name     => $model,
				is_fru         => 1,
			);
		} ## end foreach my $nvme_dir ( sort { $a cmp $b } glob(...))

		foreach my $block_dir ( sort { $a cmp $b } glob('/sys/block/*') ) {
			my $disk = $block_dir =~ s{.*/}{}r;
			# loop, dm, md, zram, and the like have no device, and NVMe is done above
			next if !-e $block_dir . '/device' || $disk =~ /^nvme/;
			next if ( read_sysfs( $block_dir . '/removable' ) // '0' ) eq '1';
			my $model = read_sysfs( $block_dir . '/device/model' ) // next;

			# VPD page 0x80 is the serial, after a 4 byte header. libata provides it for SATA.
			my $serial   = '';
			my $vpd_page = read_file( $block_dir . '/device/vpd_pg80', binmode => ':raw', err_mode => 'quiet' );
			if ( defined($vpd_page) && length($vpd_page) > 4 ) {
				$serial = substr( $vpd_page, 4 ) =~ s/[^\x20-\x7E]//gr =~ s/^\s+|\s+$//gr;
			}

			# 512 byte sectors, shown as decimal GB as drives are sold
			my $sectors = read_sysfs( $block_dir . '/size' ) // 0;
			my $vendor  = clean_dmi( read_sysfs( $block_dir . '/device/vendor' ) );
			# libata reports every SATA disk as vendor ATA
			$vendor = '' if $vendor eq 'ATA';
			$add_entity->(
				index => $index_for->( 'disk:' . realpath( $block_dir . '/device' ) ),
				descr => join( ' ', grep { $_ ne '' } $vendor, $model, sprintf( '%.0f GB', $sectors * 512 / 1e9 ) ),
				name  => $disk,
				contained_in   => 1,
				class          => $entity_classes{storage_drive},
				parent_rel_pos => $disk_position++,
				firmware_rev   => read_sysfs( $block_dir . '/device/rev' ) // '',
				serial         => $serial,
				mfg_name       => $vendor,
				model_name     => $model,
				is_fru         => 1,
			);
		} ## end foreach my $block_dir ( sort { $a cmp $b } glob...)
	} ## end if ( $opts{inventory} )

	# snmpd reads the cache as its own user
	umask(022);
	write_file( $cache_file, { atomic => 1 }, encode_json( { version => 1, updated => time, oids => \@oids } ) );
	write_file( $state_file, { atomic => 1 }, encode_json($state) );

	exit 0;
} ## end if ( $opts{u} )

if ( $opts{w} ) {
	foreach my $entry ( @{ load_cache($cache_file) } ) {
		print $entry->{oid} . ' = ' . $entry->{type} . ': ' . $entry->{value} . "\n";
	}

	exit 0;
}

# pass_persist mode. snmpd sends a command line and, for get and getnext, a OID line.
#
#     PING                       -> PONG
#     get / .1.3.6.1.2.1.47...   -> OID, type, and value lines, or NONE
#     getnext / .1.3.6...        -> the same for the next OID, or NONE
#     set / OID / type value     -> not-writable
#
# A empty line or EOF means snmpd is done with us.

my $base_oid = $opts{p};
if ( $base_oid !~ /^\.?\d+(?:\.\d+)*$/ ) {
	die( '-p "' . $base_oid . '" is not a numeric OID' );
}
$base_oid =~ s/^(?!\.)/./;

$| = 1;

my $cache_mtime = -1;
my $entries     = [];

while ( defined( my $command = <STDIN> ) ) {
	chomp($command);
	last if $command eq '';

	if ( $command eq 'PING' ) {
		print "PONG\n";
		next;
	}

	my $requested_oid = <STDIN>;
	last if !defined($requested_oid);
	chomp($requested_oid);

	if ( $command eq 'set' ) {
		# the value line, which is not used
		<STDIN>;
		print "not-writable\n";
		next;
	}

	# reload when -u has written a new cache, missing counts as 0 so it is empty until there is one
	my $current_mtime = ( stat($cache_file) )[9] // 0;
	if ( $current_mtime != $cache_mtime ) {
		$entries     = load_cache( $cache_file, $base_oid );
		$cache_mtime = $current_mtime;
	}

	my @requested_parts = grep { $_ ne '' } split( /\./, $requested_oid );
	my $found;
	if ( $command eq 'get' ) {
		($found) = grep { $_->{oid} eq '.' . join( '.', @requested_parts ) } @{$entries};
	} elsif ( $command eq 'getnext' ) {
		($found) = grep { oid_compare( $_->{parts}, \@requested_parts ) > 0 } @{$entries};
	}

	if ( defined($found) ) {
		print $found->{oid} . "\n" . $found->{type} . "\n" . $found->{value} . "\n";
	} else {
		print "NONE\n";
	}
} ## end while ( defined( my $command = <STDIN> ) )
