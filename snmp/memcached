#!/usr/bin/php
<?php

$m = new Memcached();
$m->addServer('localhost', 11211);

$stats = $m->getStats();

if (!isset($stats['localhost:11211'])) {
    echo json_encode([
        'error' => 1,
        'errorString' => 'Unable to retrieve memcached statistics',
        'version' => '1.1',
        'data' => [],
    ], JSON_UNESCAPED_SLASHES) . "\n";
    exit;
}

echo json_encode([
    'error' => 0,
    'errorString' => '',
    'version' => '1.1',
    'data' => $stats['localhost:11211'],
], JSON_UNESCAPED_SLASHES) . "\n";

