#!/usr/bin/env bash
#
# LibreNMS reboot-required SNMP extend script.
#
# Detects whether the host needs a reboot to apply a pending kernel or
# library update, across multiple distro families. Outputs "1" (reboot
# required) or "0" (not required) on success.
#
# On an unsupported distro, or when the expected detection tool is
# missing, exits non-zero with no output so LibreNMS surfaces a poll
# error instead of silently reporting "no reboot needed".

set -o pipefail

# shellcheck source=/dev/null
. /etc/os-release 2>/dev/null || exit 1

case " ${ID:-} ${ID_LIKE:-} " in
    *" debian "*|*" ubuntu "*)
        # update-notifier-common/unattended-upgrades create this file.
        [ -f /var/run/reboot-required ] && echo 1 || echo 0
        ;;
    *" rhel "*|*" fedora "*|*" centos "*|*" rocky "*|*" almalinux "*|*" amzn "*)
        # yum-utils/dnf-utils. Exit 1 = reboot required, 0 = not required.
        command -v needs-restarting >/dev/null 2>&1 || exit 1
        needs-restarting -r >/dev/null 2>&1
        [ $? -eq 1 ] && echo 1 || echo 0
        ;;
    *" suse "*)
        # zypper needs-rebooting. Exit 1 = reboot required, 0 = not required.
        command -v zypper >/dev/null 2>&1 || exit 1
        zypper needs-rebooting >/dev/null 2>&1
        [ $? -eq 1 ] && echo 1 || echo 0
        ;;
    *" arch "*)
        # No official tool: a reboot is needed once the running kernel's
        # module directory has been replaced by a newer package upgrade.
        current_kernel=$(uname -r)
        [ -d "/usr/lib/modules/$current_kernel" ] && echo 0 || echo 1
        ;;
    *)
        exit 1
        ;;
esac
